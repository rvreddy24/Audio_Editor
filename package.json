{
  "name": "soundcraft-studio",
  "version": "1.0.0",
  "description": "SoundCraft Studio - Pro Web Audio & Video Workstation",
  "main": "server/index.js",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "audio-editor",
    "audio-converter",
    "video-to-audio",
    "audio-trimmer",
    "ffmpeg",
    "soundcraft"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "wrangler": "^4.160.1"
  }
}
